{
  "name": "@gitpkg/site",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "docs/.vuepress",
    "tools/*",
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/EqualMa/gitpkg.git"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "lerna run test",
    "build": "lerna run build",
    "bootstrap": "lerna bootstrap",
    "clean": "lerna run clean && rimraf node_modules dist coverage",
    "typecheck": "lerna run typecheck"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.2",
    "@babel/preset-typescript": "^7.25.2",
    "@babel/register": "^7.25.0",
    "@eslint/js": "^9.0.0",
    "@gitpkg/common": "*",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.4",
    "jest": "^29.7.0",
    "lerna": "^8.1.2",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "@gitpkg/core": "^1.0.0-alpha"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged && lerna run precommit"
    }
  }
}
